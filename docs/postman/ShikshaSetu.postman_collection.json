{
  "info": {
    "name": "ShikshaSetu API",
    "description": "Smoke tests for the Spring Boot API against the development seed. Run the requests in order (Collection Runner or `npx newman run`). A new student is registered on every run, so the demo accounts' progress is not changed. The passwords are the documented development-seed demo accounts only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "teacherEmail",
      "value": "teacher@shiksha.org"
    },
    {
      "key": "teacherPassword",
      "value": "Teacher@123"
    },
    {
      "key": "adminEmail",
      "value": "admin@shiksha.org"
    },
    {
      "key": "adminPassword",
      "value": "Admin@123"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register student",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('studentEmail', `postman-${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('role is STUDENT', () => pm.expect(body.user.role).to.eql('STUDENT'));",
                  "pm.collectionVariables.set('studentToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Student\",\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"Postman@123\",\n  \"role\": \"STUDENT\"\n}"
            }
          }
        },
        {
          "name": "Login with a wrong password is rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('error code', () => pm.expect(pm.response.json().code).to.eql('INVALID_CREDENTIALS'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{ \"email\": \"{{teacherEmail}}\", \"password\": \"wrong-password\" }"
            }
          }
        },
        {
          "name": "Login teacher",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('teacherToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{ \"email\": \"{{teacherEmail}}\", \"password\": \"{{teacherPassword}}\", \"role\": \"TEACHER\" }"
            }
          }
        },
        {
          "name": "Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{ \"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\", \"role\": \"ADMIN\" }"
            }
          }
        },
        {
          "name": "Public ADMIN registration is rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('ROLE_NOT_ALLOWED', () => pm.expect(pm.response.json().code).to.eql('ROLE_NOT_ALLOWED'));",
                  "pm.test('no token issued', () => pm.expect(pm.response.json()).to.not.have.property('token'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{ \"name\": \"Mallory\", \"email\": \"mallory-{{$timestamp}}@example.com\", \"password\": \"Mallory@123\", \"role\": \"ADMIN\" }"
            }
          }
        },
        {
          "name": "Teacher self-registration",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.test('role TEACHER', () => pm.expect(pm.response.json().user.role).to.eql('TEACHER'));",
                  "pm.collectionVariables.set('newTeacherToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{ \"name\": \"Postman Teacher\", \"email\": \"postman-teacher-{{$timestamp}}@example.com\", \"password\": \"Teacher@1234\", \"role\": \"TEACHER\" }"
            }
          }
        },
        {
          "name": "Login with the wrong role is rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('ROLE_MISMATCH', () => pm.expect(pm.response.json().code).to.eql('ROLE_MISMATCH'));",
                  "pm.test('no token issued', () => pm.expect(pm.response.json()).to.not.have.property('token'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{ \"email\": \"{{teacherEmail}}\", \"password\": \"{{teacherPassword}}\", \"role\": \"STUDENT\" }"
            }
          }
        },
        {
          "name": "Current user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('new student starts at level 1', () => pm.expect(pm.response.json().level).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "2. Student learning loop",
      "item": [
        {
          "name": "Complete onboarding",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('onboarded', () => pm.expect(pm.response.json().onboarded).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/students/me/onboarding",
            "body": {
              "mode": "raw",
              "raw": "{ \"gradeLevel\": 8, \"preferredLanguage\": \"hi\", \"school\": \"Govt. High School\", \"district\": \"Kullu\" }"
            }
          }
        },
        {
          "name": "List subjects",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const subjects = pm.response.json();",
                  "pm.test('5 seeded subjects', () => pm.expect(subjects.length).to.eql(5));",
                  "pm.collectionVariables.set('subjectId', subjects[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": "{{baseUrl}}/subjects"
          }
        },
        {
          "name": "Subject with chapters",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('chapterId', pm.response.json().chapters[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": "{{baseUrl}}/subjects/{{subjectId}}"
          }
        },
        {
          "name": "Chapter with lessons and quiz",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const ch = pm.response.json();",
                  "pm.collectionVariables.set('lessonId', ch.lessons[0].id);",
                  "pm.collectionVariables.set('quizId', ch.quiz.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": "{{baseUrl}}/chapters/{{chapterId}}"
          }
        },
        {
          "name": "Lesson",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('has content', () => pm.expect(pm.response.json().content).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": "{{baseUrl}}/lessons/{{lessonId}}"
          }
        },
        {
          "name": "Complete lesson (+XP, FIRST_LESSON badge)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json().reward;",
                  "pm.test('XP awarded', () => pm.expect(r.xpEarned).to.be.above(0));",
                  "pm.test('first badge', () => pm.expect(r.newBadges.map(b => b.code)).to.include('FIRST_LESSON'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": "{{baseUrl}}/lessons/{{lessonId}}/complete"
          }
        },
        {
          "name": "Quiz (answers are not exposed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const q = pm.response.json();",
                  "pm.test('no correctIndex sent to client', () => pm.expect(q.questions[0]).to.not.have.property('correctIndex'));",
                  "pm.collectionVariables.set('answers', JSON.stringify(q.questions.map(x => ({ questionId: x.id, selectedIndex: 0 }))));",
                  "pm.collectionVariables.set('firstQuestionId', q.questions[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": "{{baseUrl}}/quizzes/{{quizId}}"
          }
        },
        {
          "name": "Lesson in Hindi (Accept-Language)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('served in Hindi', () => pm.expect(pm.response.json().language).to.eql('hi'));",
                  "pm.test('Devanagari text', () => pm.expect(pm.response.json().content).to.match(/[ऀ-ॿ]/));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              },
              {
                "key": "Accept-Language",
                "value": "hi"
              }
            ],
            "url": "{{baseUrl}}/lessons/{{lessonId}}"
          }
        },
        {
          "name": "Start quiz session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('nothing locked yet', () => pm.expect(pm.response.json().answers).to.have.length(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": "{{baseUrl}}/quizzes/{{quizId}}/session"
          }
        },
        {
          "name": "Lock an answer (instant feedback)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('feedback only after locking', () => pm.expect(r).to.include.keys('correct', 'correctIndex', 'explanation'));",
                  "pm.collectionVariables.set('firstCorrectIndex', r.correctIndex);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/quizzes/{{quizId}}/session/answers",
            "body": {
              "mode": "raw",
              "raw": "{ \"questionId\": {{firstQuestionId}}, \"selectedIndex\": 0 }"
            }
          }
        },
        {
          "name": "A locked answer cannot be changed",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('already answered', () => pm.expect(r.alreadyAnswered).to.eql(true));",
                  "pm.test('keeps the first answer', () => pm.expect(r.selectedIndex).to.eql(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/quizzes/{{quizId}}/session/answers",
            "body": {
              "mode": "raw",
              "raw": "{ \"questionId\": {{firstQuestionId}}, \"selectedIndex\": {{firstCorrectIndex}} }"
            }
          }
        },
        {
          "name": "The old answer-probing endpoint is gone",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/quizzes/{{quizId}}/check",
            "body": {
              "mode": "raw",
              "raw": "{ \"questionId\": {{firstQuestionId}}, \"selectedIndex\": 0 }"
            }
          }
        },
        {
          "name": "Submit quiz (graded on the server)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('clientAttemptId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const a = pm.response.json();",
                  "pm.test('score computed', () => pm.expect(a.percentage).to.be.within(0, 100));",
                  "pm.test('first attempt earns XP', () => pm.expect(a.xpEarned).to.be.above(0));",
                  "pm.collectionVariables.set('attemptId', a.attemptId);",
                  "pm.test('graded with the locked answer', () => pm.expect(a.questions[0].selectedIndex).to.eql(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/quizzes/{{quizId}}/submit",
            "body": {
              "mode": "raw",
              "raw": "{ \"clientAttemptId\": \"{{clientAttemptId}}\", \"timeTakenSeconds\": 90, \"answers\": {{answers}} }"
            }
          }
        },
        {
          "name": "Replay the same submission (idempotent offline sync)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const a = pm.response.json();",
                  "pm.test('recognised as a duplicate', () => pm.expect(a.duplicate).to.eql(true));",
                  "pm.test('same attempt returned', () => pm.expect(String(a.attemptId)).to.eql(String(pm.collectionVariables.get('attemptId'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/quizzes/{{quizId}}/submit",
            "body": {
              "mode": "raw",
              "raw": "{ \"clientAttemptId\": \"{{clientAttemptId}}\", \"timeTakenSeconds\": 90, \"answers\": {{answers}} }"
            }
          }
        },
        {
          "name": "Dashboard",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('1 lesson completed', () => pm.expect(JSON.stringify(pm.response.json())).to.include('\"lessonsCompleted\":1'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": "{{baseUrl}}/students/me/dashboard"
          }
        },
        {
          "name": "Badges",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": "{{baseUrl}}/students/me/badges"
          }
        },
        {
          "name": "Recommendations (AI service or Java fallback)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('says where it came from', () => pm.expect(pm.response.json()).to.have.property('source'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": "{{baseUrl}}/students/me/recommendations"
          }
        },
        {
          "name": "Leaderboard (weekly)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": "{{baseUrl}}/students/me/leaderboard?scope=week"
          }
        }
      ]
    },
    {
      "name": "3. Role-based access",
      "item": [
        {
          "name": "Student cannot read teacher analytics",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": "{{baseUrl}}/teacher/overview"
          }
        },
        {
          "name": "Teacher cannot use admin API",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teacherToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/stats"
          }
        },
        {
          "name": "No token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/subjects"
          }
        }
      ]
    },
    {
      "name": "4. Teacher",
      "item": [
        {
          "name": "Class overview",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('has KPIs', () => pm.expect(pm.response.json()).to.include.keys('totalStudents', 'averageScore'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
