# ---------------------------------------------------------------------------
# ShikshaSetu configuration. Copy the section you need; never commit real values.
# ---------------------------------------------------------------------------

# --- Frontend (Vite) — put these in ./.env.local ---------------------------
# API base used by the browser. Default "/api" (proxied by Vite to BACKEND_URL).
VITE_API_URL=/api
# Where the Vite dev/preview proxy forwards /api requests.
BACKEND_URL=http://localhost:8080

# --- Backend (Spring Boot) — environment variables or ./backend/.env --------
# "dev" = embedded H2 file DB (no install). "postgres" = PostgreSQL.
SPRING_PROFILES_ACTIVE=dev
# PostgreSQL profile only:
DATABASE_URL=jdbc:postgresql://localhost:5432/shikshasetu
DATABASE_USERNAME=shikshasetu
DATABASE_PASSWORD=
# At least 32 random characters. If empty, a random key is generated on each start.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=720
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=3000
APP_TIMEZONE=Asia/Kolkata
# Seeds curriculum + demo accounts into an EMPTY database. Set false for real deployments.
SEED_ENABLED=true
